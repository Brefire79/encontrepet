rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(data) {
      return isSignedIn() && (
        data.owner_uid == request.auth.uid ||
        data.owner_firebase_uid == request.auth.uid
      );
    }

    function hashFields() {
      return [
        'imageHash',
        'imageHashAlgo',
        'imageHashVersion',
        'imageHashCreatedAt',
        'imageHashProcessed'
      ];
    }

    function suspiciousAdminFields() {
      return ['suspiciousFlag', 'suspiciousReason', 'flaggedByUid'];
    }

    function canCreateAlert() {
      return isOwner(request.resource.data)
        && !request.resource.data.keys().hasAny(hashFields());
    }

    function canUpdateOwnAlert() {
      let changed = request.resource.data.diff(resource.data).changedKeys();
      return isOwner(resource.data)
        && !changed.hasAny(hashFields());
    }

    // ========================================
    //  COLLECTIONS PÚBLICAS — leitura aberta
    //  Campos públicos permitidos:
    //    telefone_publico, telefone_publico_ativo
    //    (opt-in do tutor/observador)
    //  Campos que NUNCA estão aqui (ficam em alert_privado):
    //    endereco_privado, latitude_privada, longitude_privada,
    //    contato_email, contato_telefone (quando não público)
    // ========================================

    match /pets_perdidos/{alertId} {
      allow read: if true;
      allow create: if canCreateAlert();
      allow update: if canUpdateOwnAlert();
      allow delete: if isOwner(resource.data);
    }

    match /avistamentos/{alertId} {
      allow read: if true;
      allow create: if canCreateAlert();
      allow update: if canUpdateOwnAlert();
      allow delete: if isOwner(resource.data);
    }

    // ========================================
    //  COLLECTION PRIVADA (LGPD)
    //  Apenas o owner pode ler e escrever
    // ========================================

    match /alert_privado/{docId} {
      allow read: if isSignedIn() && (
        resource.data.owner_firebase_uid == request.auth.uid ||
        resource.data.owner_uid == request.auth.uid
      );
      allow create: if isSignedIn() && (
        request.resource.data.owner_firebase_uid == request.auth.uid ||
        request.resource.data.owner_uid == request.auth.uid
      );
      allow update: if isSignedIn() && (
        resource.data.owner_firebase_uid == request.auth.uid ||
        resource.data.owner_uid == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.owner_firebase_uid == request.auth.uid ||
        resource.data.owner_uid == request.auth.uid
      );
    }

    // ========================================
    //  USUÁRIOS
    //  - list (query por email no login): qualquer auth anônima/logada
    //  - get (leitura direta por ID): apenas o próprio dono
    //  - create/update: apenas o próprio dono
    // ========================================

    match /usuarios/{uid} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && uid == request.auth.uid;
      allow create: if isSignedIn() && uid == request.auth.uid;
      allow update: if isSignedIn() && uid == request.auth.uid;
      allow delete: if false;
    }

    // ========================================
    //  NOTIFICAÇÕES
    // ========================================

    match /notificacoes/{docId} {
      allow read, write: if isSignedIn();
    }

    // ========================================
    //  RECUPERACAO DE SENHA
    //  Apenas Cloud Functions (admin SDK) podem ler/escrever.
    //  Clientes nao tem acesso direto — seguranca do token.
    // ========================================

    match /password_resets/{token} {
      allow read, write: if false;
    }

    // ========================================
    //  FALLBACK GLOBAL — negar tudo
    // ========================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
