rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(data) {
      return isSignedIn() && (
        data.owner_uid == request.auth.uid ||
        data.owner_firebase_uid == request.auth.uid
      );
    }

    // Campos de hash gerados SOMENTE por Cloud Functions (admin SDK).
    // imageHashProcessed é um flag de status que o cliente pode definir
    // como false na criação — não está na lista de bloqueio.
    function hashFields() {
      return [
        'imageHash',
        'imageHashAlgo',
        'imageHashVersion',
        'imageHashCreatedAt'
      ];
    }

    // [S-08] Ownership derivado do alert_privado (o doc público deixa de
    // carregar owner_firebase_uid). Custo: +2 reads (exists+get) por
    // update/delete de docs já "stripados"; docs legados continuam casando
    // por isOwner() sem custo extra durante a transição.
    function ownsAlertViaPrivate(collection, alertId) {
      let pid = collection + '_' + alertId;
      return isSignedIn()
        && exists(/databases/$(database)/documents/alert_privado/$(pid))
        && get(/databases/$(database)/documents/alert_privado/$(pid)).data.owner_firebase_uid == request.auth.uid;
    }

    // [S-08] create sem owner_firebase_uid no público: exige owner_uid; se o
    // campo legado vier (cliente antigo em cache), precisa ser o próprio UID.
    // Integridade real do ownership: alert_privado (create exige
    // owner_firebase_uid == auth.uid lá).
    function canCreateAlert() {
      return isSignedIn()
        && request.resource.data.owner_uid is string
        && request.resource.data.owner_uid.size() > 0
        && !request.resource.data.keys().hasAny(hashFields())
        && (!('owner_firebase_uid' in request.resource.data)
            || request.resource.data.owner_firebase_uid == request.auth.uid);
    }

    function canUpdateOwnAlert(collection, alertId) {
      let changed = request.resource.data.diff(resource.data).changedKeys();
      return (isOwner(resource.data) || ownsAlertViaPrivate(collection, alertId))
        && !changed.hasAny(hashFields());
    }

    // Confirmação BILATERAL de reunião (North Star).
    // O tutor (dono) marca o pet como 'aguardando_confirmacao' e registra a
    // contraparte em reuniao.avistador_firebase_uid. APENAS essa contraparte
    // pode transicionar para 'encontrado'/desfecho 'reuniao_confirmada',
    // alterando somente os campos de encerramento (nunca dados do alerta).
    function canConfirmReunion() {
      let changed = request.resource.data.diff(resource.data).changedKeys();
      return isSignedIn()
        && resource.data.status == 'aguardando_confirmacao'
        && resource.data.reuniao.avistador_firebase_uid == request.auth.uid
        && request.resource.data.reuniao.confirmado_por_firebase_uid == request.auth.uid
        && request.resource.data.desfecho == 'reuniao_confirmada'
        && request.resource.data.status == 'encontrado'
        && changed.hasOnly(['status', 'desfecho', 'data_encerrado', 'reuniao'])
        && !changed.hasAny(hashFields());
    }

    // Admin identificado por documento em admin_roles/{firebaseAuthUID}
    // (criado manualmente via Firebase Console — clientes não podem escrever)
    function isFirestoreAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admin_roles/$(request.auth.uid));
    }

    // Campos protegidos que usuários comuns nunca podem alterar em si mesmos
    function protectedUserFields() {
      return ['role', 'status'];
    }

    // ========================================
    //  COLLECTIONS PÚBLICAS — leitura aberta
    //  Campos públicos permitidos:
    //    telefone_publico, telefone_publico_ativo
    //    (opt-in do tutor/observador)
    //  Campos que NUNCA estão aqui (ficam em alert_privado):
    //    endereco_privado, latitude_privada, longitude_privada,
    //    contato_email, contato_telefone (quando não público)
    // ========================================

    match /pets_perdidos/{alertId} {
      allow read: if true;
      allow create: if canCreateAlert();
      allow update: if canUpdateOwnAlert('pets_perdidos', alertId) || isFirestoreAdmin() || canConfirmReunion();
      allow delete: if isOwner(resource.data) || ownsAlertViaPrivate('pets_perdidos', alertId) || isFirestoreAdmin();
    }

    match /avistamentos/{alertId} {
      allow read: if true;
      allow create: if canCreateAlert();
      allow update: if canUpdateOwnAlert('avistamentos', alertId) || isFirestoreAdmin();
      allow delete: if isOwner(resource.data) || ownsAlertViaPrivate('avistamentos', alertId) || isFirestoreAdmin();
    }

    // ========================================
    //  COLLECTION PRIVADA (LGPD)
    //  Somente o dono lê. Contato de terceiros sai apenas pelo backend
    //  (get-tutor-contact / get-sighter-contact, com lgpd_access_log);
    //  o UID da contraparte vem de vinculos_avistamento (só UIDs).
    //  Auditoria: S-01 (2026-03-21), revisado plano Spark
    // ========================================

    match /alert_privado/{docId} {
      allow get: if isSignedIn() && (
        resource.data.owner_firebase_uid == request.auth.uid ||
        resource.data.owner_uid == request.auth.uid
      );
      allow list: if false;
      allow create: if isSignedIn() && (
        request.resource.data.owner_firebase_uid == request.auth.uid ||
        request.resource.data.owner_uid == request.auth.uid
      );
      allow update, delete: if isSignedIn() && (
        resource.data.owner_firebase_uid == request.auth.uid ||
        resource.data.owner_uid == request.auth.uid
      );
    }

    // Foto cheia fora do doc público (custo — sem Storage no Spark).
    // ID = '{colecao}_{alertId}', o mesmo do alert_privado: só o dono do
    // alerta grava. Leitura pública por ID (como o doc público); sem list.
    match /fotos/{fotoId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isSignedIn()
        && exists(/databases/$(database)/documents/alert_privado/$(fotoId))
        && get(/databases/$(database)/documents/alert_privado/$(fotoId)).data.owner_firebase_uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['dataUrl', 'created_at'])
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() <= 200000;
      allow delete: if isFirestoreAdmin() || (isSignedIn()
        && get(/databases/$(database)/documents/alert_privado/$(fotoId)).data.owner_firebase_uid == request.auth.uid);
    }

    // [S-08 leitura] Vínculo avistamento↔pet só com UIDs (sem contato nem
    // localização). Gravado pelo backend (Admin SDK) no process-avistamento;
    // o tutor usa para achar a contraparte da confirmação bilateral.
    match /vinculos_avistamento/{avistamentoId} {
      allow get: if isSignedIn() && (
        resource.data.pet_owner_firebase_uid == request.auth.uid ||
        resource.data.sighter_firebase_uid == request.auth.uid
      );
      allow list, create, update, delete: if false;
    }

    // ========================================
    //  AUTORIZAÇÕES AVISTADOR→PET
    //  Criadas pelo avistador ao vincular um avistamento a um pet.
    //  Documento ID: {sighterFirebaseUid}_{petId}
    //  Imutável após criação — apenas criação é permitida.
    // ========================================

    match /sighter_authorizations/{authId} {
      allow create: if isSignedIn() &&
        request.resource.data.sighter_firebase_uid == request.auth.uid;
      allow get: if isSignedIn() && (
        resource.data.sighter_firebase_uid == request.auth.uid ||
        resource.data.pet_owner_firebase_uid == request.auth.uid
      );
      allow list: if false;
      allow update, delete: if false;
    }

    // ========================================
    //  LOG DE AUDITORIA LGPD
    //  Apenas create, amarrado ao ator autenticado (N-03) — impede
    //  poluir o log em nome de terceiros. CFs gravam via Admin SDK.
    //  Nenhum cliente lê ou altera logs.
    // ========================================

    match /lgpd_access_log/{docId} {
      allow create: if isSignedIn()
        && request.resource.data.actor_firebase_uid == request.auth.uid
        && request.resource.data.tipo is string
        && request.resource.data.tipo.size() <= 60;
      allow read, update, delete: if false;
    }

    // ========================================
    //  USUÁRIOS
    //  O app usa IDs customizados (u_xxx) gerados pelo cliente,
    //  que não coincidem com Firebase Auth UIDs (anonymous ou email).
    //  Por isso as regras usam request.auth.token.email para ownership
    //  após migração, ou permitem create para qualquer auth válida
    //  (unicidade de email é garantida pela camada de aplicação).
    // ========================================

    function isUserOwner(storedEmail) {
      return request.auth.token.email != null
        && request.auth.token.email == storedEmail;
    }

    // ========================================
    //  ADMIN ROLES
    //  Documentos criados manualmente via Firebase Console.
    //  Chave: Firebase Auth UID do admin (não u_xxx).
    //  Imutável pelo cliente — apenas leitura pelo próprio admin.
    //  Exemplo: /admin_roles/{firebaseUid} → { email: 'admin@...' }
    // ========================================

    match /admin_roles/{adminUid} {
      allow get: if adminUid == request.auth.uid;
      allow list, create, update, delete: if false;
    }

    // Vínculo doc u_xxx ↔ Firebase Auth UID: firebase_auth_uids é preenchido
    // no cadastro (cliente) e a cada login via CF loginUser (Admin SDK).
    function isBoundUser(data) {
      return request.auth.uid in data.get('firebase_auth_uids', []);
    }

    match /usuarios/{uid} {
      // list (N-01): SOMENTE admin. Histórico: limit<=200 deixava qualquer
      // autenticado enumerar nome/e-mail/telefone da base (LGPD); a compat
      // transitória limit<=1 caiu em 2026-09-25 — com startAfter ela ainda
      // permitia baixar a base um a um. O backend (login-user /
      // check-email-exists) resolve e-mail sem listar.
      allow list: if isFirestoreAdmin();
      // get direto por ID: próprio UID, email do Firebase Auth bate com o doc,
      // ou Firebase Auth UID vinculado (firebase_auth_uids)
      allow get: if isSignedIn() && (
        uid == request.auth.uid ||
        isUserOwner(resource.data.email) ||
        isBoundUser(resource.data) ||
        isFirestoreAdmin()
      );
      // create: qualquer auth válida (app garante unicidade de email)
      allow create: if isSignedIn();
      // update: dono pode atualizar, mas NÃO pode alterar role/status
      // Admin pode alterar qualquer campo incluindo role/status
      allow update: if isSignedIn() && (
        isFirestoreAdmin() ||
        (
          (uid == request.auth.uid || isUserOwner(resource.data.email) || isBoundUser(resource.data)) &&
          !request.resource.data.diff(resource.data).changedKeys().hasAny(protectedUserFields())
        )
      );
      allow delete: if false;
    }

    // ========================================
    //  NOTIFICAÇÕES
    //  Leitura/alteração restritas ao destinatário.
    //  Criação validada (N-02): tipo permitido + limites de tamanho —
    //  evita spam/phishing interno se passando pelo sistema.
    //  CFs criam notificações via Admin SDK (não passam por aqui).
    //  Auditoria: S-02 (2026-03-21), N-02 (2026-07-04)
    // ========================================

    match /notificacoes/{docId} {
      allow read: if isSignedIn() && (
        resource.data.destinatario_firebase_uid == request.auth.uid ||
        resource.data.destinatario_uid == request.auth.uid
      );
      allow create: if isSignedIn()
        && request.resource.data.tipo in ['match_ia', 'avistamento_contato', 'confirmar_reuniao', 'reuniao_confirmada']
        && (request.resource.data.destinatario_uid is string
            || request.resource.data.destinatario_firebase_uid is string)
        && (!('mensagem' in request.resource.data)
            || (request.resource.data.mensagem is string
                && request.resource.data.mensagem.size() <= 500));
      allow update, delete: if isSignedIn() && (
        resource.data.destinatario_firebase_uid == request.auth.uid ||
        resource.data.destinatario_uid == request.auth.uid
      );
    }

    // ========================================
    //  CHAT INTERNO ENTRE TUTOR E AVISTADOR
    //  Criado pela Cloud Function em matches altos.
    //  Apenas participantes leem e enviam mensagens.
    // ========================================

    match /conversas/{conversaId} {
      allow read: if isSignedIn() &&
        request.auth.uid in resource.data.participantes_firebase_uids;
      allow create: if false;
      allow update: if isSignedIn() &&
        request.auth.uid in resource.data.participantes_firebase_uids &&
        request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['lastMessage', 'lastMessageAt', 'updatedAt']);
      allow delete: if false;

      match /mensagens/{mensagemId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversas/$(conversaId)).data.participantes_firebase_uids;
        allow create: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversas/$(conversaId)).data.participantes_firebase_uids &&
          request.resource.data.autor_firebase_uid == request.auth.uid &&
          request.resource.data.texto is string &&
          request.resource.data.texto.size() > 0 &&
          request.resource.data.texto.size() <= 1000;
        allow update, delete: if false;
      }
    }

    // ========================================
    //  SENHAS (S-03)
    //  senha_hash movido de usuarios para aqui.
    //  Clientes nunca acessam — apenas admin SDK
    //  via Cloud Functions saveUserPassword e verifyUserPassword.
    // ========================================

    match /senhas_usuarios/{uid} {
      allow read, write: if false;
    }

    // ========================================
    //  FALLBACK GLOBAL — negar tudo
    // ========================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
