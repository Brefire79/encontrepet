rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(data) {
      return isSignedIn() && (
        data.owner_uid == request.auth.uid ||
        data.owner_firebase_uid == request.auth.uid
      );
    }

    // Campos de hash gerados SOMENTE por Cloud Functions (admin SDK).
    // imageHashProcessed é um flag de status que o cliente pode definir
    // como false na criação — não está na lista de bloqueio.
    function hashFields() {
      return [
        'imageHash',
        'imageHashAlgo',
        'imageHashVersion',
        'imageHashCreatedAt'
      ];
    }

    function canCreateAlert() {
      return isOwner(request.resource.data)
        && !request.resource.data.keys().hasAny(hashFields());
    }

    function canUpdateOwnAlert() {
      let changed = request.resource.data.diff(resource.data).changedKeys();
      return isOwner(resource.data)
        && !changed.hasAny(hashFields());
    }

    // Confirmação BILATERAL de reunião (North Star).
    // O tutor (dono) marca o pet como 'aguardando_confirmacao' e registra a
    // contraparte em reuniao.avistador_firebase_uid. APENAS essa contraparte
    // pode transicionar para 'encontrado'/desfecho 'reuniao_confirmada',
    // alterando somente os campos de encerramento (nunca dados do alerta).
    function canConfirmReunion() {
      let changed = request.resource.data.diff(resource.data).changedKeys();
      return isSignedIn()
        && resource.data.status == 'aguardando_confirmacao'
        && resource.data.reuniao.avistador_firebase_uid == request.auth.uid
        && request.resource.data.reuniao.confirmado_por_firebase_uid == request.auth.uid
        && request.resource.data.desfecho == 'reuniao_confirmada'
        && request.resource.data.status == 'encontrado'
        && changed.hasOnly(['status', 'desfecho', 'data_encerrado', 'reuniao'])
        && !changed.hasAny(hashFields());
    }

    // Admin identificado por documento em admin_roles/{firebaseAuthUID}
    // (criado manualmente via Firebase Console — clientes não podem escrever)
    function isFirestoreAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admin_roles/$(request.auth.uid));
    }

    // Campos protegidos que usuários comuns nunca podem alterar em si mesmos
    function protectedUserFields() {
      return ['role', 'status'];
    }

    // ========================================
    //  COLLECTIONS PÚBLICAS — leitura aberta
    //  Campos públicos permitidos:
    //    telefone_publico, telefone_publico_ativo
    //    (opt-in do tutor/observador)
    //  Campos que NUNCA estão aqui (ficam em alert_privado):
    //    endereco_privado, latitude_privada, longitude_privada,
    //    contato_email, contato_telefone (quando não público)
    // ========================================

    match /pets_perdidos/{alertId} {
      allow read: if true;
      allow create: if canCreateAlert();
      allow update: if canUpdateOwnAlert() || isFirestoreAdmin() || canConfirmReunion();
      allow delete: if isOwner(resource.data) || isFirestoreAdmin();
    }

    match /avistamentos/{alertId} {
      allow read: if true;
      allow create: if canCreateAlert();
      allow update: if canUpdateOwnAlert() || isFirestoreAdmin();
      allow delete: if isOwner(resource.data) || isFirestoreAdmin();
    }

    // ========================================
    //  COLLECTION PRIVADA (LGPD)
    //  Acesso direto: owner lê seus próprios dados.
    //  Acesso cruzado (sem Cloud Function):
    //    • Tutor lê alert_privado do avistamento se
    //      linked_pet_owner_firebase_uid == request.auth.uid
    //    • Avistador lê alert_privado do pet se existir
    //      sighter_authorizations/{uid}_{petId}
    //  Auditoria: S-01 (2026-03-21), revisado plano Spark
    // ========================================

    match /alert_privado/{docId} {
      allow get: if isSignedIn() && (
        resource.data.owner_firebase_uid == request.auth.uid ||
        resource.data.owner_uid == request.auth.uid
      );
      allow list: if false;
      allow create: if isSignedIn() && (
        request.resource.data.owner_firebase_uid == request.auth.uid ||
        request.resource.data.owner_uid == request.auth.uid
      );
      allow update, delete: if isSignedIn() && (
        resource.data.owner_firebase_uid == request.auth.uid ||
        resource.data.owner_uid == request.auth.uid
      );
    }

    // ========================================
    //  AUTORIZAÇÕES AVISTADOR→PET
    //  Criadas pelo avistador ao vincular um avistamento a um pet.
    //  Documento ID: {sighterFirebaseUid}_{petId}
    //  Imutável após criação — apenas criação é permitida.
    // ========================================

    match /sighter_authorizations/{authId} {
      allow create: if isSignedIn() &&
        request.resource.data.sighter_firebase_uid == request.auth.uid;
      allow get: if isSignedIn() && (
        resource.data.sighter_firebase_uid == request.auth.uid ||
        resource.data.pet_owner_firebase_uid == request.auth.uid
      );
      allow list: if false;
      allow update, delete: if false;
    }

    // ========================================
    //  LOG DE AUDITORIA LGPD
    //  Apenas create — nenhum cliente lê ou altera logs.
    // ========================================

    match /lgpd_access_log/{docId} {
      allow create: if isSignedIn();
      allow read, update, delete: if false;
    }

    // ========================================
    //  USUÁRIOS
    //  O app usa IDs customizados (u_xxx) gerados pelo cliente,
    //  que não coincidem com Firebase Auth UIDs (anonymous ou email).
    //  Por isso as regras usam request.auth.token.email para ownership
    //  após migração, ou permitem create para qualquer auth válida
    //  (unicidade de email é garantida pela camada de aplicação).
    // ========================================

    function isUserOwner(storedEmail) {
      return request.auth.token.email != null
        && request.auth.token.email == storedEmail;
    }

    // ========================================
    //  ADMIN ROLES
    //  Documentos criados manualmente via Firebase Console.
    //  Chave: Firebase Auth UID do admin (não u_xxx).
    //  Imutável pelo cliente — apenas leitura pelo próprio admin.
    //  Exemplo: /admin_roles/{firebaseUid} → { email: 'admin@...' }
    // ========================================

    match /admin_roles/{adminUid} {
      allow get: if adminUid == request.auth.uid;
      allow list, create, update, delete: if false;
    }

    match /usuarios/{uid} {
      // list: necessário para findByEmail (login/cadastro) e painel admin.
      // fsList() usa limit 200 por padrão — regra bloqueia queries acima disso para users normais.
      // Admin (isFirestoreAdmin) lista sem restrição de limite.
      // Limitação conhecida: sem Cloud Functions (Spark plan) não há como
      // fazer projeção de campos ou mover senha_hash para collection protegida.
      allow list: if isSignedIn() && (
        isFirestoreAdmin() ||
        request.query.limit <= 200
      );
      // get direto por ID: próprio UID ou email do Firebase Auth bate com o doc
      allow get: if isSignedIn() && (
        uid == request.auth.uid ||
        isUserOwner(resource.data.email) ||
        isFirestoreAdmin()
      );
      // create: qualquer auth válida (app garante unicidade de email)
      allow create: if isSignedIn();
      // update: dono pode atualizar, mas NÃO pode alterar role/status
      // Admin pode alterar qualquer campo incluindo role/status
      allow update: if isSignedIn() && (
        isFirestoreAdmin() ||
        (
          (uid == request.auth.uid || isUserOwner(resource.data.email)) &&
          !request.resource.data.diff(resource.data).changedKeys().hasAny(protectedUserFields())
        )
      );
      allow delete: if false;
    }

    // ========================================
    //  NOTIFICAÇÕES
    //  Leitura/alteração restritas ao destinatário.
    //  Escrita aberta para autenticados (sistema gera notificações).
    //  Auditoria: S-02 (2026-03-21)
    // ========================================

    match /notificacoes/{docId} {
      allow read: if isSignedIn() && (
        resource.data.destinatario_firebase_uid == request.auth.uid ||
        resource.data.destinatario_uid == request.auth.uid
      );
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        resource.data.destinatario_firebase_uid == request.auth.uid ||
        resource.data.destinatario_uid == request.auth.uid
      );
    }

    // ========================================
    //  CHAT INTERNO ENTRE TUTOR E AVISTADOR
    //  Criado pela Cloud Function em matches altos.
    //  Apenas participantes leem e enviam mensagens.
    // ========================================

    match /conversas/{conversaId} {
      allow read: if isSignedIn() &&
        request.auth.uid in resource.data.participantes_firebase_uids;
      allow create: if false;
      allow update: if isSignedIn() &&
        request.auth.uid in resource.data.participantes_firebase_uids &&
        request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['lastMessage', 'lastMessageAt', 'updatedAt']);
      allow delete: if false;

      match /mensagens/{mensagemId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversas/$(conversaId)).data.participantes_firebase_uids;
        allow create: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversas/$(conversaId)).data.participantes_firebase_uids &&
          request.resource.data.autor_firebase_uid == request.auth.uid &&
          request.resource.data.texto is string &&
          request.resource.data.texto.size() > 0 &&
          request.resource.data.texto.size() <= 1000;
        allow update, delete: if false;
      }
    }

    // ========================================
    //  SENHAS (S-03)
    //  senha_hash movido de usuarios para aqui.
    //  Clientes nunca acessam — apenas admin SDK
    //  via Cloud Functions saveUserPassword e verifyUserPassword.
    // ========================================

    match /senhas_usuarios/{uid} {
      allow read, write: if false;
    }

    // ========================================
    //  FALLBACK GLOBAL — negar tudo
    // ========================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
